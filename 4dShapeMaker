<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>4D Shape Maker — Build Your Own</title>
<style>
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    background:#05070d;color:#c9d4e8;overflow:hidden;
    -webkit-font-smoothing:antialiased;
  }
  .app{display:flex;height:100vh}

  /* ---------- panel ---------- */
  .panel{
    width:352px;flex:0 0 352px;height:100%;overflow-y:auto;
    background:linear-gradient(180deg,#0b0f1a,#080b13);
    border-right:1px solid #1b2436;padding:16px 16px 60px;
    scrollbar-width:thin;scrollbar-color:#26324d transparent;
  }
  .panel::-webkit-scrollbar{width:9px}
  .panel::-webkit-scrollbar-thumb{background:#1e283d;border-radius:9px;border:2px solid #080b13}
  header h1{
    margin:2px 0 2px;font-size:17px;letter-spacing:.3px;font-weight:650;
    background:linear-gradient(90deg,#7aa2ff,#c88bff 60%,#ff8ab8);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  header .sub{margin:0 0 14px;font-size:11.5px;color:#5d6c88;letter-spacing:.4px}
  .group{
    background:#0a0e19;border:1px solid #161f31;border-radius:12px;
    padding:12px;margin-bottom:12px;
  }
  .group h2{
    margin:0 0 10px;font-size:11px;font-weight:600;letter-spacing:1.1px;
    text-transform:uppercase;color:#5d6c88;
  }
  label.field{display:block;font-size:11.5px;color:#7c8bab;margin:9px 0 5px}
  label.field small{color:#4d5a75}
  select,textarea,input[type=number]{
    width:100%;background:#070b13;border:1px solid #1e283d;border-radius:8px;
    color:#9fb3d4;font-size:12px;padding:8px;font-family:inherit;
  }
  textarea{
    font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;
    line-height:1.5;resize:vertical;
  }
  select:focus,textarea:focus{outline:none;border-color:#3f63ff}
  .btnrow{display:flex;gap:6px;margin-top:9px;flex-wrap:wrap}
  button{
    flex:1 1 auto;background:#16203a;color:#c9d4e8;border:1px solid #26324d;
    padding:7px 9px;border-radius:8px;font-size:12px;cursor:pointer;
    font-family:inherit;transition:background .15s,border-color .15s,color .15s;
    white-space:nowrap;
  }
  button:hover{background:#1e2a48;border-color:#3a4c74}
  button:active{transform:translateY(1px)}
  button.primary{background:#182a63;border-color:#3f63ff;color:#b6c8ff}
  button.primary:hover{background:#1f3479}
  button.active{background:#1f3479;border-color:#3f63ff;color:#c3d3ff;box-shadow:0 0 0 1px #3f63ff55 inset}

  .tip{
    font-size:11px;color:#5d6c88;line-height:1.6;margin:9px 0 0;
    padding:8px 10px;background:#070b13;border:1px solid #141d2e;border-radius:8px;
  }
  .tip b{color:#9db0d4;font-weight:600}
  .tip .k{
    display:inline-block;background:#131c2e;border:1px solid #22304a;border-radius:4px;
    padding:0 4px;font-size:10px;color:#8fa0bf;font-family:ui-monospace,monospace;
  }

  /* rotation rows */
  .rot-row{
    display:grid;grid-template-columns:26px 1fr 42px 16px;
    align-items:center;gap:7px;margin-bottom:5px;
  }
  .rot-name{font-size:11px;color:#7c8bab;font-family:ui-monospace,monospace}
  .rot-deg{font-size:10.5px;color:#4d5a75;text-align:right;font-variant-numeric:tabular-nums}
  .rot-row input[type=range]{width:100%;accent-color:#5b8cff;height:16px}
  .rot-row input[type=checkbox]{accent-color:#c88bff;cursor:pointer;margin:0}

  .check{display:flex;align-items:center;gap:7px;font-size:12px;color:#8fa0bf;margin-top:9px;cursor:pointer}
  .check input{accent-color:#5b8cff;cursor:pointer;margin:0}

  .slider-row{display:flex;align-items:center;gap:8px;margin-top:4px}
  .slider-row input[type=range]{flex:1;accent-color:#5b8cff;height:16px}
  .slider-row .val{font-size:10.5px;color:#4d5a75;min-width:34px;text-align:right;font-variant-numeric:tabular-nums}

  /* ---------- stage ---------- */
  .stage{flex:1;position:relative;min-width:0}
  canvas{
    display:block;width:100%;height:100%;cursor:grab;
    background:radial-gradient(circle at 50% 45%,#0e1626 0%,#05070d 72%);
    touch-action:none;
  }
  .hint{
    position:absolute;left:50%;bottom:14px;transform:translateX(-50%);
    font-size:11px;color:#3d4a63;letter-spacing:.3px;pointer-events:none;
    white-space:nowrap;background:#05070d99;padding:5px 12px;border-radius:20px;
    border:1px solid #121a2a;
  }
  .stats{
    position:absolute;left:14px;top:12px;font-size:11px;color:#3d4a63;
    font-variant-numeric:tabular-nums;pointer-events:none;letter-spacing:.4px;
  }
  .badge{
    position:absolute;right:14px;top:12px;font-size:10.5px;letter-spacing:1px;
    text-transform:uppercase;color:#8fb0ff;background:#12203f;border:1px solid #2c4a94;
    padding:4px 10px;border-radius:20px;pointer-events:none;display:none;
  }
  .badge.on{display:block}
  @media (max-width:760px){
    .app{flex-direction:column}
    .panel{width:100%;flex:0 0 auto;max-height:52vh;border-right:none;border-bottom:1px solid #1b2436}
    .stage{flex:1 1 auto;min-height:48vh}
    .hint{font-size:10px}
  }
</style>
</head>
<body>
<div class="app">
  <aside class="panel">
    <header>
      <h1>4D Shape Maker</h1>
      <p class="sub">HYPERDIMENSIONAL WIREFRAME STUDIO</p>
    </header>

    <section class="group">
      <h2>Build your own</h2>
      <div class="btnrow">
        <button id="btnBuild">✎ Build mode: off</button>
      </div>
      <p class="tip" id="buildTip">
        Turn on <b>build mode</b> to draw your own 4D shape directly on the canvas.
      </p>
      <div class="btnrow">
        <button id="btnUndo">↶ Undo</button>
        <button id="btnDelSel">Delete selected</button>
      </div>
      <div class="btnrow">
        <button id="btnSave">⭳ Save</button>
        <button id="btnLoad">⭱ Load</button>
      </div>
      <input type="file" id="fileInput" accept=".json,application/json" hidden>
    </section>

    <section class="group">
      <h2>Shape presets</h2>
      <select id="presetSelect">
        <option value="tesseract">Tesseract · 8-cell — 16 vertices</option>
        <option value="simplex">5-cell · simplex — 5 vertices</option>
        <option value="cell16">16-cell · hyperoctahedron — 8 vertices</option>
        <option value="cell24">24-cell — 24 vertices</option>
        <option value="duo33">Duoprism 3 × 3 — 9 vertices</option>
        <option value="duo44">Duoprism 4 × 4 — 16 vertices</option>
        <option value="duo58">Duoprism 5 × 8 — 40 vertices</option>
      </select>
      <div class="btnrow">
        <button id="btnRandom">Random point cloud</button>
      </div>
    </section>

    <section class="group">
      <h2>Rotation planes</h2>
      <div id="rotRows"></div>
      <label class="field" style="margin-top:12px">Spin speed</label>
      <div class="slider-row">
        <input type="range" id="speed" min="0" max="3" step="0.05" value="0.7">
        <span class="val" id="speedVal">0.70</span>
      </div>
    </section>

    <section class="group">
      <h2>Projection</h2>
      <label class="field">4D focal distance</label>
      <div class="slider-row">
        <input type="range" id="d4" min="1.3" max="6" step="0.05" value="2.7">
        <span class="val" id="d4Val">2.70</span>
      </div>
      <label class="field">3D focal distance</label>
      <div class="slider-row">
        <input type="range" id="d3" min="1.6" max="8" step="0.05" value="3.4">
        <span class="val" id="d3Val">3.40</span>
      </div>
      <label class="field">Edge width</label>
      <div class="slider-row">
        <input type="range" id="ew" min="0.3" max="4" step="0.05" value="1.3">
        <span class="val" id="ewVal">1.30</span>
      </div>
      <label class="check"><input type="checkbox" id="showVerts" checked> Show vertices</label>
      <label class="check"><input type="checkbox" id="glow" checked> Additive glow</label>
      <div class="btnrow">
        <button id="btnReset">Reset view</button>
      </div>
    </section>

    <section class="group">
      <h2>Manual editor</h2>
      <label class="field">Vertices <small>— x, y, z, w per line</small></label>
      <textarea id="vertText" rows="6" spellcheck="false"></textarea>
      <label class="field">Edges <small>— i - j per line</small></label>
      <textarea id="edgeText" rows="6" spellcheck="false"></textarea>
      <div class="btnrow">
        <button id="btnApply" class="primary">Apply</button>
        <button id="btnAuto">Auto-connect</button>
      </div>
      <div class="btnrow">
        <button id="btnAdd">+ Random vertex</button>
        <button id="btnClear">Clear</button>
      </div>
    </section>
  </aside>

  <main class="stage">
    <canvas id="c"></canvas>
    <div class="stats" id="stats"></div>
    <div class="badge" id="badge">Build mode</div>
    <div class="hint" id="hint">drag = rotate XY &nbsp;·&nbsp; shift+drag = XW / YW &nbsp;·&nbsp; scroll = zoom</div>
  </main>
</div>

<script>
(function(){
'use strict';

/* ============================================================
   Math helpers
   ============================================================ */
const PLANE_KEYS  = ['xy','xz','xw','yz','yw','zw'];
const SPIN_SIGN   = { xy: 1, xz:-1, xw: 1, yz: 1, yw:-1, zw: 1 };

const clamp = (v,a,b)=> v<a?a:(v>b?b:v);

function rot(p, i, j, a){
  if(!a) return;
  const c = Math.cos(a), s = Math.sin(a);
  const pi = p[i], pj = p[j];
  p[i] = pi*c - pj*s;
  p[j] = pi*s + pj*c;
}
function rotate4(p, A){
  rot(p,0,1,A.xy); rot(p,0,2,A.xz); rot(p,0,3,A.xw);
  rot(p,1,2,A.yz); rot(p,1,3,A.yw); rot(p,2,3,A.zw);
}
function unrotate4(p, A){
  rot(p,2,3,-A.zw); rot(p,1,3,-A.yw); rot(p,1,2,-A.yz);
  rot(p,0,3,-A.xw); rot(p,0,2,-A.xz); rot(p,0,1,-A.xy);
}
function dist2(a,b){
  const dx=a[0]-b[0], dy=a[1]-b[1], dz=a[2]-b[2], dw=a[3]-b[3];
  return dx*dx+dy*dy+dz*dz+dw*dw;
}
function gauss(){
  let u=0,v=0;
  while(!u) u=Math.random();
  while(!v) v=Math.random();
  return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}
function normalizeVerts(v){
  let m = 0;
  for(const p of v) m = Math.max(m, Math.hypot(p[0],p[1],p[2],p[3]));
  if(m > 1e-9) for(const p of v) for(let i=0;i<4;i++) p[i] /= m;
  return v;
}

/* ============================================================
   Shape generators
   ============================================================ */
function hypercube(){
  const v = [];
  for(let i=0;i<16;i++) v.push([(i&1)?1:-1,(i&2)?1:-1,(i&4)?1:-1,(i&8)?1:-1]);
  const e = [];
  for(let i=0;i<16;i++) for(let j=i+1;j<16;j++){
    let d=0;
    for(let k=0;k<4;k++) if(v[i][k]!==v[j][k]) d++;
    if(d===1) e.push([i,j]);
  }
  return {v:normalizeVerts(v), e};
}
function simplex(){
  const s = Math.sqrt(5);
  const v = [
    [ 1, 1, 1, -1/s],
    [ 1,-1,-1, -1/s],
    [-1, 1,-1, -1/s],
    [-1,-1, 1, -1/s],
    [ 0, 0, 0,  4/s]
  ];
  const e = [];
  for(let i=0;i<5;i++) for(let j=i+1;j<5;j++) e.push([i,j]);
  return {v:normalizeVerts(v), e};
}
function crossPolytope(){
  const v = [];
  for(let i=0;i<4;i++){
    const a=[0,0,0,0]; a[i]= 1; v.push(a);
    const b=[0,0,0,0]; b[i]=-1; v.push(b);
  }
  const e = [];
  for(let i=0;i<8;i++) for(let j=i+1;j<8;j++)
    if(Math.abs(dist2(v[i],v[j]) - 2) < 1e-6) e.push([i,j]);
  return {v:normalizeVerts(v), e};
}
function cell24(){
  const pairs = [[0,1],[0,2],[0,3],[1,2],[1,3],[2,3]];
  const v = [];
  for(const [a,b] of pairs)
    for(const sa of [1,-1])
      for(const sb of [1,-1]){
        const p=[0,0,0,0]; p[a]=sa; p[b]=sb; v.push(p);
      }
  const e = [];
  for(let i=0;i<v.length;i++) for(let j=i+1;j<v.length;j++)
    if(Math.abs(dist2(v[i],v[j]) - 2) < 1e-6) e.push([i,j]);
  return {v:normalizeVerts(v), e};
}
function duoprism(n,m){
  const v = [], e = [];
  for(let a=0;a<n;a++) for(let b=0;b<m;b++){
    const t = 2*Math.PI*a/n, p = 2*Math.PI*b/m;
    v.push([Math.cos(t), Math.sin(t), Math.cos(p), Math.sin(p)]);
  }
  const idx = (a,b)=> a*m + b;
  for(let a=0;a<n;a++) for(let b=0;b<m;b++){
    e.push([idx(a,b), idx((a+1)%n, b)]);
    e.push([idx(a,b), idx(a, (b+1)%m)]);
  }
  return {v:normalizeVerts(v), e};
}
function randomCloud(n, k){
  n = n || 46; k = k || 3;
  const v = [];
  for(let i=0;i<n;i++){
    const p = [gauss(),gauss(),gauss(),gauss()];
    const L = Math.hypot(p[0],p[1],p[2],p[3]) || 1;
    v.push([p[0]/L, p[1]/L, p[2]/L, p[3]/L]);
  }
  const set = new Set();
  for(let i=0;i<n;i++){
    const ds = [];
    for(let j=0;j<n;j++) if(j!==i) ds.push([dist2(v[i],v[j]), j]);
    ds.sort((a,b)=>a[0]-b[0]);
    for(let t=0;t<Math.min(k, ds.length);t++){
      const j = ds[t][1];
      set.add(i<j ? i+'-'+j : j+'-'+i);
    }
  }
  return {v, e: [...set].map(s=>s.split('-').map(Number))};
}

const PRESETS = {
  tesseract: hypercube,
  simplex:   simplex,
  cell16:    crossPolytope,
  cell24:    cell24,
  duo33:     ()=>duoprism(3,3),
  duo44:     ()=>duoprism(4,4),
  duo58:     ()=>duoprism(5,8)
};

/* ============================================================
   State
   ============================================================ */
const state = {
  verts: [],
  edges: [],
  angles: { xy:0, xz:0, xw:0.55, yz:0.32, yw:0, zw:0.18 },
  spin:   { xy:false, xz:false, xw:true, yz:true, yw:false, zw:false },
  speed: 0.7,
  d4: 2.7,
  d3: 3.4,
  zoom: 1,
  edgeWidth: 1.3,
  showVerts: true,
  glow: true,
  buildMode: false,
  selected: -1,
  hover: -1
};

let history = [];
const MAX_HISTORY = 100;

/* ============================================================
   Canvas
   ============================================================ */
const canvas  = document.getElementById('c');
const ctx     = canvas.getContext('2d');
const statsEl = document.getElementById('stats');
const badgeEl = document.getElementById('badge');
const hintEl  = document.getElementById('hint');
const tipEl   = document.getElementById('buildTip');

let W = 1, H = 1;
let projected = [];                        // {sx, sy, depth, z, w, k}
const mouse = { x:0, y:0, inside:false };

function resize(){
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const r = canvas.parentElement.getBoundingClientRect();
  W = Math.max(1, Math.round(r.width));
  H = Math.max(1, Math.round(r.height));
  canvas.width  = Math.round(W * dpr);
  canvas.height = Math.round(H * dpr);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
if(window.ResizeObserver) new ResizeObserver(resize).observe(canvas.parentElement);
else window.addEventListener('resize', resize);

function viewParams(){
  return {
    scale: Math.min(W, H) * 0.26 * state.zoom,
    cx: W * 0.5,
    cy: H * 0.5
  };
}

/* ============================================================
   Projection helpers  (screen <-> 4D world)
   ============================================================ */
function screenToWorld4(sx, sy){
  const {scale, cx, cy} = viewParams();
  const p = [(sx - cx) / scale, (cy - sy) / scale, 0, 0];
  unrotate4(p, state.angles);
  // keep inside a reasonable hypersphere
  const n = Math.hypot(p[0], p[1], p[2], p[3]);
  if(n > 1.7){ const k = 1.7 / n; p[0]*=k; p[1]*=k; p[2]*=k; p[3]*=k; }
  return p;
}

function moveVertexTo(idx, sx, sy){
  const A = state.angles;
  const v = state.verts[idx];
  if(!v) return;
  const p = [v[0], v[1], v[2], v[3]];
  rotate4(p, A);
  const k4 = state.d4 / Math.max(0.25, state.d4 - p[3]);
  const z3 = p[2] * k4;
  const k3 = state.d3 / Math.max(0.25, state.d3 - z3);
  const {scale, cx, cy} = viewParams();
  const denom = Math.max(1e-6, scale * k4 * k3);
  p[0] = (sx - cx) / denom;
  p[1] = (cy - sy) / denom;
  unrotate4(p, A);
  state.verts[idx] = p;
}

/* ============================================================
   Render
   ============================================================ */
function draw(){
  ctx.clearRect(0, 0, W, H);
  const verts = state.verts;

  if(!verts.length){
    projected = [];
    statsEl.textContent = 'empty';
    return;
  }

  const A = state.angles;
  const pts = [];
  let zmin =  Infinity, zmax = -Infinity;
  let wmin =  Infinity, wmax = -Infinity;

  for(let i=0;i<verts.length;i++){
    const v = verts[i];
    const p = [v[0], v[1], v[2], v[3]];
    rotate4(p, A);

    const k4 = state.d4 / Math.max(0.25, state.d4 - p[3]);
    const x3 = p[0]*k4, y3 = p[1]*k4, z3 = p[2]*k4;
    const k3 = state.d3 / Math.max(0.25, state.d3 - z3);

    pts.push({ x:x3*k3, y:y3*k3, z:z3, w:v[3], k:k4*k3 });

    if(z3 < zmin) zmin = z3;
    if(z3 > zmax) zmax = z3;
    if(v[3] < wmin) wmin = v[3];
    if(v[3] > wmax) wmax = v[3];
  }

  const zr = Math.max(1e-6, zmax - zmin);
  const wr = Math.max(1e-6, wmax - wmin);
  const {scale, cx, cy} = viewParams();

  for(const p of pts){
    p.sx = cx + p.x * scale;
    p.sy = cy - p.y * scale;
    p.depth = (p.z - zmin) / zr;
  }
  projected = pts;

  const hueOf = w => 265 - 265 * clamp((w - wmin) / wr, 0, 1);

  /* ---- edges, back to front ---- */
  const list = state.edges
    .map(e => ({a:e[0], b:e[1], z:(pts[e[0]] ? pts[e[0]].z : 0) + (pts[e[1]] ? pts[e[1]].z : 0)}))
    .sort((p,q) => p.z - q.z);

  ctx.globalCompositeOperation = state.glow ? 'lighter' : 'source-over';
  ctx.lineCap = 'round';

  for(const ed of list){
    const P = pts[ed.a], Q = pts[ed.b];
    if(!P || !Q) continue;
    const d = (P.depth + Q.depth) * 0.5;
    const alpha = 0.10 + 0.80 * d * d;
    const hue   = hueOf((P.w + Q.w) * 0.5);
    const light = 38 + 32 * d;
    ctx.strokeStyle = 'hsla(' + hue.toFixed(0) + ',95%,' + light.toFixed(0) + '%,' + alpha.toFixed(3) + ')';
    ctx.lineWidth = state.edgeWidth * (0.45 + 0.95 * d);
    ctx.beginPath();
    ctx.moveTo(P.sx, P.sy);
    ctx.lineTo(Q.sx, Q.sy);
    ctx.stroke();
  }
  ctx.globalCompositeOperation = 'source-over';

  /* ---- vertices, back to front ---- */
  if(state.showVerts){
    const order = pts.map((_,i)=>i).sort((a,b)=> pts[a].z - pts[b].z);
    for(const i of order){
      const p = pts[i];
      const kScale = clamp(p.k, 0.55, 2.2);
      const r = (1.5 + 2.8 * p.depth) * kScale;
      const hue = hueOf(p.w);
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, r, 0, Math.PI*2);
      ctx.fillStyle = 'hsla(' + hue.toFixed(0) + ',100%,' + (55 + 25*p.depth).toFixed(0) + '%,' + (0.30 + 0.65*p.depth).toFixed(2) + ')';
      ctx.fill();
    }
  }

  /* ---- build-mode overlays ---- */
  if(state.buildMode){
    // ghost line from selected vertex to cursor
    if(state.selected >= 0 && state.selected < pts.length && mouse.inside){
      const S = pts[state.selected];
      ctx.save();
      ctx.setLineDash([4, 5]);
      ctx.strokeStyle = 'rgba(140,175,255,0.55)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(S.sx, S.sy);
      ctx.lineTo(mouse.x, mouse.y);
      ctx.stroke();
      ctx.restore();
    }
    // hover ring
    if(state.hover >= 0 && state.hover < pts.length){
      const p = pts[state.hover];
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, 8, 0, Math.PI*2);
      ctx.strokeStyle = 'rgba(200,139,255,0.85)';
      ctx.lineWidth = 1.4;
      ctx.stroke();
    }
    // selection ring
    if(state.selected >= 0 && state.selected < pts.length){
      const p = pts[state.selected];
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, 11, 0, Math.PI*2);
      ctx.strokeStyle = 'rgba(120,170,255,0.95)';
      ctx.lineWidth = 1.8;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, 3.2, 0, Math.PI*2);
      ctx.fillStyle = '#cfe0ff';
      ctx.fill();
    }
  }

  statsEl.textContent = verts.length + ' vertices · ' + state.edges.length + ' edges';
}

/* ============================================================
   Hit testing
   ============================================================ */
function pickVertex(x, y){
  let best = -1, bd = 16 * 16;
  for(let i=0;i<projected.length;i++){
    const p = projected[i];
    const dx = p.sx - x, dy = p.sy - y;
    const d = dx*dx + dy*dy;
    if(d < bd){ bd = d; best = i; }
  }
  return best;
}
function localPos(e){
  const r = canvas.getBoundingClientRect();
  return { x: e.clientX - r.left, y: e.clientY - r.top };
}

/* ============================================================
   Shape mutation (raw + history-wrapped)
   ============================================================ */
const vertText = document.getElementById('vertText');
const edgeText = document.getElementById('edgeText');

function vertsToText(v){
  return v.map(p => p.map(x => (Math.abs(x) < 1e-4 ? 0 : x).toFixed(3)).join(', ')).join('\n');
}
function edgesToText(e){
  return e.map(p => p[0] + ' - ' + p[1]).join('\n');
}
function syncEditor(){
  vertText.value = vertsToText(state.verts);
  edgeText.value = edgesToText(state.edges);
  updateTip();
}

function pushHistory(){
  history.push({
    v: state.verts.map(p => p.slice()),
    e: state.edges.map(e => e.slice())
  });
  if(history.length > MAX_HISTORY) history.shift();
}

function addVertexRaw(p){
  state.verts.push(p);
  return state.verts.length - 1;
}
function toggleEdgeRaw(a, b){
  const k = state.edges.findIndex(([x,y]) => (x===a && y===b) || (x===b && y===a));
  if(k >= 0) state.edges.splice(k, 1);
  else state.edges.push([a, b]);
}
function removeVertexRaw(i){
  state.verts.splice(i, 1);
  state.edges = state.edges
    .filter(([a,b]) => a !== i && b !== i)
    .map(([a,b]) => [a > i ? a-1 : a, b > i ? b-1 : b]);
  state.selected = -1;
  state.hover = -1;
}

function addVertex(p){ pushHistory(); const i = addVertexRaw(p); syncEditor(); return i; }
function toggleEdge(a,b){ pushHistory(); toggleEdgeRaw(a,b); syncEditor(); }
function removeVertex(i){
  if(i < 0 || i >= state.verts.length) return;
  pushHistory();
  removeVertexRaw(i);
  syncEditor();
}
function undo(){
  const s = history.pop();
  if(!s) return;
  state.verts = s.v;
  state.edges = s.e;
  state.selected = -1;
  state.hover = -1;
  syncEditor();
  draw();
}

function setShape(shape, sync){
  state.verts = shape.v.map(p => p.slice());
  state.edges = shape.e
    .filter(([a,b]) => a>=0 && b>=0 && a<shape.v.length && b<shape.v.length && a!==b)
    .map(e => e.slice());
  state.selected = -1;
  state.hover = -1;
  if(sync !== false) syncEditor();
  statsEl.textContent = '';
}

/* ============================================================
   Animation loop
   ============================================================ */
let lastT = performance.now();

function frame(t){
  const dt = Math.min(0.05, (t - lastT) / 1000);
  lastT = t;

  for(const k of PLANE_KEYS){
    if(state.spin[k]){
      let a = state.angles[k] + state.speed * dt * SPIN_SIGN[k];
      if(a >  Math.PI) a -= Math.PI * 2;
      if(a < -Math.PI) a += Math.PI * 2;
      state.angles[k] = a;
    }
  }

  syncSliders();
  draw();
  requestAnimationFrame(frame);
}

/* ============================================================
   Rotation UI
   ============================================================ */
const rotRowsEl = document.getElementById('rotRows');
const rotSliders = {};
const rotDegs = {};

for(const key of PLANE_KEYS){
  const row = document.createElement('div');
  row.className = 'rot-row';

  const name = document.createElement('span');
  name.className = 'rot-name';
  name.textContent = key.toUpperCase();

  const slider = document.createElement('input');
  slider.type = 'range';
  slider.min = -180; slider.max = 180; slider.step = 0.5;
  slider.value = (state.angles[key] * 180 / Math.PI).toFixed(1);

  const deg = document.createElement('span');
  deg.className = 'rot-deg';
  deg.textContent = Math.round(state.angles[key] * 180 / Math.PI) + '°';

  slider.addEventListener('input', () => {
    state.angles[key] = parseFloat(slider.value) * Math.PI / 180;
    deg.textContent = Math.round(parseFloat(slider.value)) + '°';
  });

  const spin = document.createElement('input');
  spin.type = 'checkbox';
  spin.checked = state.spin[key];
  spin.title = 'auto-spin this plane';
  spin.addEventListener('change', () => { state.spin[key] = spin.checked; });

  row.append(name, slider, deg, spin);
  rotRowsEl.appendChild(row);

  rotSliders[key] = slider;
  rotDegs[key] = deg;
}

function syncSliders(){
  for(const key of PLANE_KEYS){
    const el = rotSliders[key];
    if(document.activeElement === el) continue;
    const deg = state.angles[key] * 180 / Math.PI;
    if(Math.abs(parseFloat(el.value) - deg) > 0.05){
      el.value = deg.toFixed(1);
      rotDegs[key].textContent = Math.round(deg) + '°';
    }
  }
}

/* ============================================================
   Sliders / checkboxes
   ============================================================ */
function bindSlider(id, valId, key, fmt){
  const el = document.getElementById(id);
  const out = document.getElementById(valId);
  const upd = () => {
    state[key] = parseFloat(el.value);
    out.textContent = fmt(state[key]);
  };
  el.addEventListener('input', upd);
  upd();
}
bindSlider('speed','speedVal','speed', v => v.toFixed(2));
bindSlider('d4','d4Val','d4', v => v.toFixed(2));
bindSlider('d3','d3Val','d3', v => v.toFixed(2));
bindSlider('ew','ewVal','edgeWidth', v => v.toFixed(2));

document.getElementById('showVerts').addEventListener('change', e => { state.showVerts = e.target.checked; });
document.getElementById('glow').addEventListener('change', e => { state.glow = e.target.checked; });
document.getElementById('btnReset').addEventListener('click', () => {
  state.zoom = 1;
  state.angles = { xy:0, xz:0, xw:0.55, yz:0.32, yw:0, zw:0.18 };
  syncSliders();
});

/* ============================================================
   Build mode
   ============================================================ */
const btnBuild = document.getElementById('btnBuild');

function updateTip(){
  if(!state.buildMode){
    tipEl.innerHTML = 'Turn on <b>build mode</b> to draw your own 4D shape directly on the canvas.';
    hintEl.textContent = 'drag = rotate XY · shift+drag = XW / YW · scroll = zoom';
    return;
  }
  hintEl.textContent = 'click = add vertex · click vertex = select · drag vertex = move · right-click = delete';

  let html = '';
  if(state.selected >= 0 && state.selected < state.verts.length){
    const v = state.verts[state.selected];
    html += '<b>Vertex ' + state.selected + '</b> selected &nbsp;(' +
            v.map(x => (Math.abs(x)<1e-4?0:x).toFixed(2)).join(', ') + ')<br>';
    html += 'Click another vertex to link / unlink.<br>';
    html += 'Click empty space to add a linked vertex.<br>';
  } else {
    html += '<b>Nothing selected.</b><br>';
    html += 'Click empty space to drop a vertex.<br>';
    html += 'Click a vertex to start linking a chain.<br>';
  }
  html += '<span class="k">Alt</span>+click or right-click a vertex to delete it. ';
  html += '<span class="k">Del</span> removes the selection, ';
  html += '<span class="k">Ctrl</span>+<span class="k">Z</span> undoes.';
  tipEl.innerHTML = html;
}

function setBuildMode(on){
  state.buildMode = on;
  state.selected = -1;
  state.hover = -1;
  btnBuild.textContent = '✎ Build mode: ' + (on ? 'ON' : 'off');
  btnBuild.classList.toggle('active', on);
  badgeEl.classList.toggle('on', on);
  canvas.style.cursor = on ? 'crosshair' : 'grab';
  updateTip();
}
btnBuild.addEventListener('click', () => setBuildMode(!state.buildMode));
document.getElementById('btnUndo').addEventListener('click', undo);
document.getElementById('btnDelSel').addEventListener('click', () => {
  if(state.selected >= 0) removeVertex(state.selected);
});

/* ---------- save / load ---------- */
document.getElementById('btnSave').addEventListener('click', () => {
  const data = {
    verts: state.verts,
    edges: state.edges,
    angles: state.angles
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], {type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'shape4d.json';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
});

const fileInput = document.getElementById('fileInput');
document.getElementById('btnLoad').addEventListener('click', () => fileInput.click());
fileInput.addEventListener('change', e => {
  const f = e.target.files && e.target.files[0];
  if(!f) return;
  const r = new FileReader();
  r.onload = () => {
    try{
      const d = JSON.parse(r.result);
      if(!Array.isArray(d.verts)) throw new Error('bad file');
      const v = d.verts
        .filter(p => Array.isArray(p) && p.length >= 4)
        .map(p => [+p[0]||0, +p[1]||0, +p[2]||0, +p[3]||0]);
      const ee = (d.edges || [])
        .filter(p => Array.isArray(p) && p.length >= 2)
        .map(p => [parseInt(p[0],10), parseInt(p[1],10)]);
      pushHistory();
      setShape({v, e: ee}, true);
      if(d.angles){
        for(const k of PLANE_KEYS){
          if(typeof d.angles[k] === 'number') state.angles[k] = d.angles[k];
        }
        syncSliders();
      }
    }catch(err){
      alert('Could not read that file. Expecting JSON with "verts" and "edges".');
    }
  };
  r.readAsText(f);
  e.target.value = '';
});

/* ============================================================
   Pointer interaction
   ============================================================ */
const ptr = {
  down:false, mode:null, moved:false, historyPushed:false,
  startX:0, startY:0, lastX:0, lastY:0, idx:-1, button:0
};

canvas.addEventListener('contextmenu', e => e.preventDefault());

canvas.addEventListener('pointerdown', e => {
  const p = localPos(e);
  ptr.down = true;
  ptr.moved = false;
  ptr.historyPushed = false;
  ptr.startX = ptr.lastX = p.x;
  ptr.startY = ptr.lastY = p.y;
  ptr.button = e.button;
  ptr.idx = -1;

  // right-click: delete a vertex under the cursor
  if(e.button === 2){
    if(state.buildMode){
      const hit = pickVertex(p.x, p.y);
      if(hit >= 0) removeVertex(hit);
    }
    ptr.mode = null;
    return;
  }

  if(state.buildMode && e.button === 0){
    const hit = pickVertex(p.x, p.y);
    if(hit >= 0){
      if(e.altKey){ removeVertex(hit); ptr.mode = null; return; }
      ptr.mode = 'vertex';
      ptr.idx = hit;
      try{ canvas.setPointerCapture(e.pointerId); }catch(_){}
      return;
    }
  }

  ptr.mode = 'rotate';
  try{ canvas.setPointerCapture(e.pointerId); }catch(_){}
});

canvas.addEventListener('pointermove', e => {
  const p = localPos(e);
  mouse.x = p.x; mouse.y = p.y; mouse.inside = true;

  if(!ptr.down){
    state.hover = state.buildMode ? pickVertex(p.x, p.y) : -1;
    return;
  }

  const dx = p.x - ptr.lastX;
  const dy = p.y - ptr.lastY;
  ptr.lastX = p.x; ptr.lastY = p.y;

  if(!ptr.moved && (Math.abs(p.x - ptr.startX) + Math.abs(p.y - ptr.startY)) > 4){
    ptr.moved = true;
  }

  if(ptr.mode === 'rotate'){
    const s = 0.0075;
    if(e.shiftKey){
      state.angles.xw -= dx * s;
      state.angles.yw += dy * s;
    } else {
      state.angles.xz -= dx * s;
      state.angles.yz += dy * s;
    }
    syncSliders();
  } else if(ptr.mode === 'vertex'){
    if(!ptr.historyPushed){ pushHistory(); ptr.historyPushed = true; }
    moveVertexTo(ptr.idx, p.x, p.y);
    if(ptr.moved) syncEditor();
  }
});

function endPointer(e){
  const p = localPos(e);

  if(ptr.down && !ptr.moved){
    if(ptr.mode === 'vertex' && ptr.idx >= 0){
      const hit = ptr.idx;
      if(state.selected === -1){
        state.selected = hit;
      } else if(state.selected === hit){
        state.selected = -1;
      } else {
        pushHistory();
        toggleEdgeRaw(state.selected, hit);
        syncEditor();
        state.selected = hit;
      }
      updateTip();
    } else if(ptr.mode === 'rotate' && state.buildMode && e.button === 0){
      // click on empty space → add a vertex (and link it if something is selected)
      pushHistory();
      const w = screenToWorld4(p.x, p.y);
      const idx = addVertexRaw(w);
      if(state.selected >= 0 && state.selected !== idx){
        toggleEdgeRaw(state.selected, idx);
      }
      state.selected = idx;
      syncEditor();
    }
  }

  ptr.down = false;
  ptr.mode = null;
  ptr.idx = -1;
  ptr.historyPushed = false;
  try{ canvas.releasePointerCapture(e.pointerId); }catch(_){}
}
canvas.addEventListener('pointerup', endPointer);
canvas.addEventListener('pointercancel', () => {
  ptr.down = false; ptr.mode = null; ptr.idx = -1; ptr.historyPushed = false;
});
canvas.addEventListener('pointerleave', () => { mouse.inside = false; state.hover = -1; });

canvas.addEventListener('wheel', e => {
  e.preventDefault();
  state.zoom = clamp(state.zoom * Math.exp(-e.deltaY * 0.0012), 0.15, 6);
}, {passive:false});

/* ============================================================
   Keyboard shortcuts
   ============================================================ */
window.addEventListener('keydown', e => {
  const tag = (e.target.tagName || '').toLowerCase();
  if(tag === 'textarea' || tag === 'input' || tag === 'select') return;

  if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z'){
    e.preventDefault();
    undo();
    return;
  }
  if(e.key === 'Delete' || e.key === 'Backspace'){
    if(state.selected >= 0){
      e.preventDefault();
      removeVertex(state.selected);
    }
    return;
  }
  if(e.key === 'Escape'){
    state.selected = -1;
    updateTip();
    return;
  }
  if(e.key.toLowerCase() === 'b'){
    setBuildMode(!state.buildMode);
  }
});

/* ============================================================
   Manual editor
   ============================================================ */
function parseVerts(text){
  const v = [];
  for(const line of text.split('\n')){
    const nums = line.split(/[\s,;]+/).filter(Boolean).map(Number).filter(n => !isNaN(n));
    if(nums.length >= 4) v.push([nums[0], nums[1], nums[2], nums[3]]);
  }
  return v;
}
function parseEdges(text, n){
  const e = [];
  for(const line of text.split('\n')){
    const m = line.match(/(-?\d+)\D+(-?\d+)/);
    if(!m) continue;
    const a = parseInt(m[1], 10), b = parseInt(m[2], 10);
    if(a >= 0 && b >= 0 && a < n && b < n && a !== b) e.push([a,b]);
  }
  return e;
}

document.getElementById('btnApply').addEventListener('click', () => {
  const v = parseVerts(vertText.value);
  if(!v.length){ alert('No valid vertices found. Use one "x, y, z, w" per line.'); return; }
  const e = parseEdges(edgeText.value, v.length);
  pushHistory();
  setShape({v, e}, true);
});

document.getElementById('btnAuto').addEventListener('click', () => {
  const v = parseVerts(vertText.value);
  if(v.length < 2){ alert('Add at least two vertices first.'); return; }
  const k = Math.min(3, v.length - 1);
  const set = new Set();
  for(let i=0;i<v.length;i++){
    const ds = [];
    for(let j=0;j<v.length;j++) if(j !== i) ds.push([dist2(v[i],v[j]), j]);
    ds.sort((a,b)=>a[0]-b[0]);
    for(let t=0;t<k;t++){
      const j = ds[t][1];
      set.add(i < j ? i+'-'+j : j+'-'+i);
    }
  }
  pushHistory();
  setShape({v, e: [...set].map(s => s.split('-').map(Number))}, true);
});

document.getElementById('btnAdd').addEventListener('click', () => {
  const p = [gauss(), gauss(), gauss(), gauss()];
  const L = Math.hypot(p[0],p[1],p[2],p[3]) || 1;
  const line = [p[0]/L, p[1]/L, p[2]/L, p[3]/L].map(x => x.toFixed(3)).join(', ');
  vertText.value = vertText.value.trim()
    ? vertText.value.replace(/\s*$/,'') + '\n' + line
    : line;
});

document.getElementById('btnClear').addEventListener('click', () => {
  pushHistory();
  vertText.value = '';
  edgeText.value = '';
  setShape({v:[], e:[]}, false);
  syncEditor();
});

/* ============================================================
   Presets
   ============================================================ */
const presetSelect = document.getElementById('presetSelect');
presetSelect.addEventListener('change', () => {
  const gen = PRESETS[presetSelect.value];
  if(gen){ pushHistory(); setShape(gen(), true); }
});
document.getElementById('btnRandom').addEventListener('click', () => {
  pushHistory();
  setShape(randomCloud(46, 3), true);
});

/* ============================================================
   Boot
   ============================================================ */
resize();
setShape(hypercube(), true);
updateTip();
requestAnimationFrame(frame);

})();
</script>
